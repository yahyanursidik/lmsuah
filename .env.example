# Copy file ini ke .env dan isi dengan value yang sebenarnya
# JANGAN PERNAH COMMIT file .env ke version control

# URL Koneksi Neon PostgreSQL
# Untuk environment production, set ini di pengaturan environment variable Netlify.
DATABASE_URL="postgres://[user]:[password]@[host]/[dbname]?sslmode=require"

# Server only: set these in Netlify environment variables for production.
# Generate a random secret of at least 32 characters; do not use an example value.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:5173"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Google OAuth authorized redirect URI must match the application origin:
# Local: http://localhost:5173/api/auth/callback/google
# Production: https://YOUR-DOMAIN/api/auth/callback/google
# Never prefix GOOGLE_CLIENT_SECRET or BETTER_AUTH_SECRET with VITE_.
## Advanced program features: leave disabled until migration and isolated tests pass.
LMS_PRIVATE_PDF_ENABLED=false
LMS_PROGRAM_REVISIONS_ENABLED=false
## Netlify provides Blobs context in production. Optional server-only local credentials:
NETLIFY_SITE_ID=
NETLIFY_BLOBS_TOKEN=

# Contabo S3 - server only. SIN is selected by the endpoint, not the signing region.
CONTABO_ENDPOINT=https://sin1.contabostorage.com
CONTABO_BUCKET=lmsuah
CONTABO_PUBLIC_URL=https://sin1.contabostorage.com/68671c4afe7c45fba062c1c65a776541:lmsuah
CONTABO_SIGNING_REGION=us-east-1
CONTABO_ACCESS_KEY_ID=
CONTABO_SECRET_ACCESS_KEY=
# Existing Netlify S3_* names are supported instead of the CONTABO_* family:
# S3_ACCESS_KEY_ID= / S3_SECRET_ACCESS_KEY= (use one complete pair, never mix)
# S3_ENDPOINT= / S3_BUCKET= / S3_REGION=us-east-1 / S3_PUBLIC_URL=
# lmsuah Public URL exposes private ACL objects: Contabo private uploads are blocked.
# Keep private PDFs in Netlify Blobs. Existing document keys remain readable.
LMS_PRIVATE_PDF_STORAGE=netlify
